# DigitalOcean Spaces (object storage for uploads). Set these in the
# DigitalOcean App Platform env for production. When unset, uploads fall
# back to local disk (dev only — ephemeral on App Platform).
SPACES_KEY=your_spaces_access_key
SPACES_SECRET=your_spaces_secret_key
SPACES_BUCKET=heyports-uploads
SPACES_REGION=blr1
# Optional overrides:
# SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
# SPACES_CDN_ENDPOINT=https://heyports-uploads.blr1.cdn.digitaloceanspaces.com
# SPACES_PUBLIC=true          # public-read objects + direct URLs (default)
# SPACES_PRESIGN_TTL=3600      # presigned URL seconds when SPACES_PUBLIC=false

# SMTP (email: SOS alerts, contact-us, password reset). Unset → logged only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@heyports.com
SUPPORT_EMAIL=support@heyports.com

# Razorpay (payments). Unset → mock/debug mode (orders + verification simulated).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
